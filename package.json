{
  "name": "reminder-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal AI-powered reminder app (local) — React + Express + Notion + Claude",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:server:dev\" \"npm:client\"",
    "server": "node server/index.js",
    "server:dev": "nodemon --quiet --watch server -e js server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "pwa": "npm run build && npm run start",
    "preview": "vite preview",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@notionhq/client": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "better-auth": "^1.6.15",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.40.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "lucide-react": "^1.17.0",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.0",
    "nodemon": "^3.1.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0"
  }
}
