# ─────────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your own values.
#  The server reads this at startup — none of it reaches the browser
#  except the VITE_* keys (which are safe to expose).
# ─────────────────────────────────────────────────────────────────

# --- Server ---
PORT=3001
# Public URL used for Stripe redirect URLs (no trailing slash).
# Example: https://reminders.yourname.com
APP_URL=http://localhost:3001
# URL the browser is served from (used for CORS + password-reset links).
FRONTEND_URL=http://localhost:5173
# Set to "production" on your host (Railway sets this automatically).
# NODE_ENV=production

# --- Auth (better-auth) ---
# REQUIRED IN PRODUCTION. Signs session cookies — if unset, the server refuses
# to boot rather than fall back to a public default (which would let anyone forge
# a login). Generate a strong value:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the auth server (your deployed URL, no trailing slash).
BETTER_AUTH_URL=http://localhost:3001
# Postgres connection string for the auth tables.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Groq (AI parsing) ---
# Your key from https://console.groq.com/keys
GROQ_API_KEY=
# Model used for natural-language parsing.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional override (defaults to the public Groq endpoint).
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Notion (data store) ---
# Internal integration secret from https://www.notion.so/profile/integrations
NOTION_TOKEN=
# A Notion page shared with the integration. The app creates a "Reminders"
# database under this page on first run. Paste the page URL or ID.
NOTION_PARENT_PAGE_ID=
# Leave blank — auto-filled after the database is created on first run.
NOTION_DATABASE_ID=

# --- Stripe (billing) ---
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID of the Pro monthly plan (create at dashboard.stripe.com/products)
STRIPE_PRO_PRICE_ID=price_...
# Exposed to the browser for Stripe.js — safe.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Google Calendar (optional — Phase C sync) ---
# OAuth2 credentials from https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type).
# Add http://localhost:3001/api/gcal/callback to Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gcal/callback

# --- Web Push (notifications when the app is closed) ---
# Auto-generated on first run and saved to server/.runtime.json.
# Set these only to pin one keypair across deploys.
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# VAPID_SUBJECT=mailto:you@example.com
